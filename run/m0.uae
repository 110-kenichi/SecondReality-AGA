use_gui=no
win32.start_not_captured=yes
win32.nonotificationicon=yes
kickstart_rom_file=@AMIGA_KICKSTART@
chipset=aga
agnusmodel=aga
agnussize=2m
chipmem_size=2
bogomem_size=0
cpu_model=68030
cpu_speed=max
cpu_compatible=false
cpu_cycle_exact=false
fastmem_size=8
ntsc=false
uaelog=true
gfx_api=direct3d11
# PAL 50Hz に合わせる: WinUAE は既定でホストのリフレッシュ (60Hz) に
# 同期して 1.2 倍速で走るため、50Hz を明示する。
gfx_vsync=false
gfx_refreshrate=50
# 起動用 HDF (RDB + FFS パーティション DH0)。make-hdf.ps1 で作成する
hardfile2=rw,DH0:@AMIGA_WORKDIR@\m0.hdf,0,0,0,512,0,,
floppy_speed=0
nr_floppies=1
# 音声は WinUAE の既定設定を使う (明示設定で無音になる環境があるため)
# Sound: WinUAE の出力バッファ。32768 だと 44.1kHz ステレオ 16bit で
# 8192 サンプル = 約 0.19 秒、音が映像より遅れて聞こえた (2026-11-15
# 実測: 白フラッシュの絵と音のずれ 0.20 秒)。8192 = 約 0.05 秒。
sound_max_buff=8192
